# Environment
NODE_ENV=development

# Server
PORT=3000

# Session — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_hex_string
SESSION_TTL_DAYS=30

# Database
DB_PATH=./data/gift-guide.db

# Initial admin account (used once on first db:seed)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_on_first_login

# OG enrichment (fetches title + image when a URL is added to a wishlist item)
OG_FETCH_ENABLED=true
OG_FETCH_TIMEOUT_MS=3000
