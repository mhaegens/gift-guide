{
  "name": "gift-guide",
  "version": "1.0.0",
  "description": "Private family wishlist app with anonymous gift claims",
  "main": "server/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "postinstall": "npm install --prefix client",
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "db:init": "node server/db/schema.js",
    "db:seed": "node server/db/seed.js",
    "setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
